# Настройки worker. Скопируйте в worker.env и заполните. Файл worker.env в Git не попадает.
# Окружение процесса важнее этого файла. Запуск: uv run python -m pricewatch.worker;
# на Windows — deploy\windows\install-worker.ps1, затем start-worker.ps1 или autostart.ps1.

# Адрес сервера без пути: на ПК с сайтом — http://127.0.0.1:8000, на другом компьютере — https://домен
PRICEWATCH_WORKER_API_URL=http://localhost:8000
# Токен worker: выдаёт команда create-worker (сменить — rotate-worker-token); только в worker.env
PRICEWATCH_WORKER_TOKEN=
# Папка профилей браузера: cookies магазинов, в том числе после ручной проверки Авито
PRICEWATCH_WORKER_PROFILES_DIR=.browser-profiles
# Пауза опроса пустой очереди, секунд (1–600)
PRICEWATCH_WORKER_POLL_SECONDS=10
# DEBUG, INFO, WARNING или ERROR
PRICEWATCH_WORKER_LOG_LEVEL=INFO
