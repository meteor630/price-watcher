# Настройки Telegram-бота. Скопируйте в bot.env и заполните. Файл bot.env в Git не попадает.
# Окружение процесса важнее этого файла. Запуск: uv run python -m pricewatch.bot

# Адрес сервера без пути, например https://домен
PRICEWATCH_BOT_API_URL=http://localhost:8000
# Токен сервиса: выдаёт команда create-service (сменить — rotate-service-token); только в bot.env
PRICEWATCH_BOT_SERVICE_TOKEN=
# Токен бота от @BotFather; только в bot.env
PRICEWATCH_BOT_TELEGRAM_TOKEN=
# DEBUG, INFO, WARNING или ERROR
PRICEWATCH_BOT_LOG_LEVEL=INFO
