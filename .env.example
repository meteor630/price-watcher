# Скопируйте в .env и заполните. Файл .env в Git не попадает.
# Окружение процесса важнее этого файла.

# development, test или production
PRICEWATCH_ENV=development
# Адрес сайта без пути; вне development и test только https
PRICEWATCH_PUBLIC_ORIGIN=http://localhost:8000
# Сети доверенных прокси через запятую (адрес Caddy); пусто — прокси нет
PRICEWATCH_TRUSTED_PROXIES=
# DEBUG, INFO, WARNING или ERROR
PRICEWATCH_LOG_LEVEL=INFO
