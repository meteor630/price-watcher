# Скопируйте в .env и заполните. Файл .env в Git не попадает.
# Окружение процесса важнее этого файла.

# development, test или production
PRICEWATCH_ENV=development
# Адрес сайта без пути; вне development и test только https
PRICEWATCH_PUBLIC_ORIGIN=http://localhost:8000
# Адрес PostgreSQL: postgresql://пользователь:пароль@хост:порт/база; пароль — только в .env
PRICEWATCH_DATABASE_URL=postgresql://pricewatch@localhost:5432/pricewatch
# Серверный ключ HMAC для кодов, токенов и сессий, не короче 32 байт; только в .env.
# Сгенерировать: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Смена ключа разлогинивает всех пользователей и приложения.
PRICEWATCH_SECRET_KEY=
# Сети доверенных прокси через запятую (адрес Caddy); пусто — прокси нет
PRICEWATCH_TRUSTED_PROXIES=
# DEBUG, INFO, WARNING или ERROR
PRICEWATCH_LOG_LEVEL=INFO
# Адрес и порт, на которых слушает сервер; в контейнере — 0.0.0.0
PRICEWATCH_LISTEN_HOST=127.0.0.1
PRICEWATCH_LISTEN_PORT=8000
# Каталог фото товаров; входит в ежедневную резервную копию
PRICEWATCH_MEDIA_DIR=media
# Папка копий сервера, которую сайт отдаёт домашнему приёмнику (/backups/v1); пусто — не отдаёт. На сервере — /backups
PRICEWATCH_BACKUPS_DIR=
# Имя Telegram-бота без @ (необязательно, пусто — не задано): в профиле появится ссылка для привязки t.me/<имя>?start=<код>
PRICEWATCH_TELEGRAM_BOT_USERNAME=
