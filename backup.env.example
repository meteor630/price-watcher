# Настройки службы резервных копий (домашний узел). Скопируйте в backup.env и заполните. Файл backup.env в Git не попадает.
# База и папка картинок — из настроек сервера (.env). Запуск: python -m pricewatch.bootstrap backup [--once]

# Папка копий. В Docker задаётся в deploy/home/compose.yaml (/backups); на ПК это BACKUP_HOST_DIR в deploy/home/.env
PRICEWATCH_BACKUP_DIR=backups
# Открытый ключ age (age1…): им копии шифруются. Закрытый ключ (AGE-SECRET-KEY-…) — только у владельца, не на узле.
PRICEWATCH_BACKUP_RECIPIENT=
# Время ежедневной копии по Москве, ЧЧ:ММ
PRICEWATCH_BACKUP_TIME=04:30
# Куда отправлять копии: пользователь арендного сервера, который может только дописывать (deploy/vps/backup-target.sh)
PRICEWATCH_BACKUP_REMOTE=pwbackup@tunnel.example.ru
PRICEWATCH_BACKUP_SSH_PORT=22
# Закрытый ключ SSH службы копий и ключ арендного сервера (строка known_hosts). В Docker задаются в compose.yaml
# (папка deploy/home/backup-ssh, в Git не попадает)
PRICEWATCH_BACKUP_SSH_KEY=backup-ssh/id_ed25519
PRICEWATCH_BACKUP_KNOWN_HOSTS=backup-ssh/known_hosts
