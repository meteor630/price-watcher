# Настройки резервных копий на сервере. Скопируйте в backup.env и заполните. Файл backup.env в Git не попадает.
# База и папка картинок — из настроек сервера (.env). На сервере копию делает планировщик: scheduler --backups
# (разовая копия вручную: python -m pricewatch.bootstrap backup --once). Копии забирает домашний приёмник (pull.env.example).

# Папка копий. На сервере задаётся в deploy/vps/compose.yaml (том backups → /backups)
PRICEWATCH_BACKUP_DIR=backups
# Открытый ключ age (age1…): им копии шифруются. Закрытый ключ (AGE-SECRET-KEY-…) — только у владельца, не на сервере.
PRICEWATCH_BACKUP_RECIPIENT=
# Время ежедневной копии по Москве, ЧЧ:ММ
PRICEWATCH_BACKUP_TIME=04:30
