# Пароль базы для Compose домашнего узла. Скопируйте в deploy/home/.env; файл в Git не попадает.
# Только буквы и цифры (он входит в адрес базы): openssl rand -hex 24
POSTGRES_PASSWORD=
# Папка резервных копий на диске, отдельном от базы (на ПК с Docker Desktop — D:/pricewatch-backups)
BACKUP_HOST_DIR=
