# Caddy домашнего узла: HTTPS для сайта. Соединения приходят только через туннель от арендного сервера, который
# передаёт настоящий IP посетителя по PROXY protocol; заголовку верим только от сервера (10.66.0.1).
# Сертификат и закрытый ключ — только здесь (том caddy_data); получение — проверкой TLS-ALPN через пересылку 443.
# Обёртка задана для каждого порта, а перенаправление на HTTPS описано явно: сервер на :80, который Caddy создаёт сам,
# настроек не получает и заголовок PROXY принимал бы за мусор (ответ 400).
{
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 10.66.0.1/32
			}
			tls
		}
	}
	servers :80 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 10.66.0.1/32
			}
		}
	}
}

prices.meteor630.ru {
	reverse_proxy app:8000
}

http://prices.meteor630.ru {
	redir https://prices.meteor630.ru{uri} permanent
}
