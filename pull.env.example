# Настройки домашнего приёмника копий. Скопируйте в pull.env и заполните. Файл pull.env в Git не попадает.
# Запуск: python -m pricewatch.bootstrap pull-backups [--once]; дома — контейнер backup-pull (deploy/home/compose.yaml).

# Адрес сервера: только схема и домен
PRICEWATCH_PULL_API_URL=https://prices.meteor630.ru
# Токен приёмника (только чтение копий): на сервере — python -m pricewatch.bootstrap create-backup-reader --name home
PRICEWATCH_PULL_TOKEN=
# Папка копий дома. В Docker задаётся в deploy/home/compose.yaml (/backups); на ПК это BACKUP_HOST_DIR в deploy/home/.env
PRICEWATCH_PULL_DIR=backups
# Лимит размера одной копии в байтах (больше — не скачивается)
PRICEWATCH_PULL_MAX_BYTES=2147483648
# Время ежедневного забора по Москве, ЧЧ:ММ (и сразу при старте)
PRICEWATCH_PULL_TIME=07:00
